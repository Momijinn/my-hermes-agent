# =============================================================================
# Hermes Agent + Gateway 統合環境変数
# =============================================================================
# このファイルをコピーして .env を作成してください:
#   cp .env.example .env

# ──────────────────────────────────────────────────────────────────────────────
# Hermes Agent 設定
# ──────────────────────────────────────────────────────────────────────────────

# Hermes DashboardのローカルURL（Composeが設定するため変更不要）
HERMES_DASHBOARD_PUBLIC_URL=http://localhost:8642

# DashboardはComposeがローカル専用の無認証モードで起動します。
# ホスト公開は127.0.0.1:8642に限定されています。

# OpenRouterフォールバック用のAPIキー
# ローカルモデルが使えない場合にOpenRouterのモデルを使用
# https://openrouter.ai/ から取得
OPENROUTER_API_KEY=<your-openrouter-api-key>

# ──────────────────────────────────────────────────────────────────────────────
# Slack 連携設定
# ──────────────────────────────────────────────────────────────────────────────

# Slack BotユーザーのBot Token (xoxb-で始まる)
# Slack Appの「Bot Token」ページから取得
SLACK_BOT_TOKEN=<your-slack-bot-token>

# Slack AppのApp-Level Token
SLACK_APP_TOKEN=<your-slack-app-token>

# Slack AppのSigning Secret
# Slack Appの「基本信息」→「App Credentials」から取得
SLACK_SIGNING_SECRET=<your-slack-signing-secret>

# Slack連携で許可するユーザーID（カンマ区切り）
# 例: U0123456789,U9876543210
# 空欄の場合は全員許可
SLACK_ALLOWED_USERS=

# ──────────────────────────────────────────────────────────────────────────────
# Gateway 設定（GitHub Actions 連携用）
# ──────────────────────────────────────────────────────────────────────────────

# GatewayのBearerトークン（カンマ区切りで複数可）
# GitHub Actionsの HERMES_GATEWAY_TOKEN シークレットと同じ値を設定
# 例: my-super-secret-token-123,another-token-456
GATEWAY_TOKENS=your-secret-token-here

# Gatewayが受け付けるChat Completionsメッセージ本文の合計上限
GATEWAY_MAX_CONTEXT_LINES=2000
GATEWAY_MAX_CONTEXT_CHARS=200000

# Hermes OpenAI-compatible APIの内部認証トークン
# GatewayからHermesへ転送する値。GATEWAY_TOKENSとは別の強い値を推奨します。
HERMES_API_KEY=your-hermes-api-key-here

# Cloudflare Tunnelのトークン（Dashboardで作成したTunnelのtoken）
# hostnameはDashboard側でこのTunnelへ割り当てます。値はGitへ入れないでください。
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token-here
